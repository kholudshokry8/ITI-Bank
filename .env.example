# --- Required ---
# Secret used to sign login tokens (16+ characters). Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM provider: "mock" (offline, default) or "gemini" ---
LLM_PROVIDER=mock
# Only when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Optional ---
PORT=3000
DATABASE_PATH=data/credit-copilot.db
POLICY_DIR=data/policy
APPLICATIONS_DIR=data/applications
# Minimum similarity for a chunk to count as relevant (below it the system refuses to answer)
RELEVANCE_THRESHOLD=0.25
# Date used to decide which documents are in force for questions (default: today)
AS_OF_DATE=
